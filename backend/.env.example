# Guidini backend configuration. Values below are placeholders for local setup.
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/guidini
JWT_SECRET=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

GEMINI_API_KEY=your-gemini-api-key
KONNECT_API_KEY=your-konnect-api-key
KONNECT_RECEIVER_WALLET_ID=your-wallet-id
KONNECT_API_URL=your-konnect-api-endpoint

SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=your-verified-sender@example.com

BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
